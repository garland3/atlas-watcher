# atlas-watcher configuration. Loaded by pydantic-settings.
# Override locally via a sibling config.local.env (gitignored).

# Comma-separated list of "owner/name" repos to watch.
# The first entry is the default repo for single-target CLI commands.
REPOS=sandialabs/atlas-ui-3

# Durable audit record (reviews/ + ledger/) — a SEPARATE private git repo, so
# this codebase can be open-sourced without publishing third-party diffs or raw
# agent transcripts. AUDIT_DIR is its local path (relative paths resolve against
# the code repo root; empty = "<code root>/audit-data"). Bootstrap with
# `uv run atlas-watcher audit-init`.
AUDIT_REPO=garland3/ATLAS-WATCHER-LOGS
AUDIT_DIR=../ATLAS-WATCHER-LOGS
BOT_NAME=AGENT-REVIEW-BOT-3

# Agent CLIs. Each must accept the prompt on stdin.
# dclaude is typically: claude --dangerously-skip-permissions --print
DCLAUDE_CMD=claude --dangerously-skip-permissions --print
CODEX_CMD=codex exec
CLINE_CMD=cline --auto-approve true

# Agents use their own CLI login. A stale ANTHROPIC_API_KEY in the environment
# (notably one baked into a long-lived tmux server) shadows that login and 401s
# every agent, so each runner unsets it. Flip to true only if you deliberately
# drive the agents by API key.
AGENT_INHERIT_API_KEY=false

AGENT_TIMEOUT_SECS=5000
POLL_INTERVAL_SECS=5000
DIFF_CONTEXT_MAX_BYTES=200000

# Give up on a PR/issue after this many failed attempts at the same key.
# Failures are appended to the ledger as "failed" rows; a new PR commit or
# issue comment changes the key and resets the counter. To retry an exhausted
# item at the same key, remove its "failed" rows from ledger/ledger.jsonl.
MAX_RETRIES=3

# Security triage. Block-above and warn-above are risk thresholds:
# low < medium < high < critical. Set both to "critical" to disable.
SECURITY_BLOCK_ABOVE=high
SECURITY_WARN_ABOVE=medium
SECURITY_TIMEOUT_SECS=600

# Require corroboration before blocking. A lone ambiguous heuristic (one quoted
# jailbreak phrase, a stray zero-width char) is capped at "warn" — the review
# still runs, with the banner — unless the heuristic is decisive (bidi
# overrides, repeated prose directives), a second heuristic family agrees, or
# the model independently reaches the warn tier. Set false for the old
# "any single signal blocks" behavior.
SECURITY_REQUIRE_CORROBORATION=true
SECURITY_TEXT_MAX_BYTES=100000
