# atlas-watcher configuration. Loaded by pydantic-settings.
# Override locally via a sibling config.local.env (gitignored).

# Comma-separated list of "owner/name" repos to watch.
# The first entry is the default repo for single-target CLI commands.
REPOS=sandialabs/atlas-ui-3

# Durable audit record (reviews/ + ledger/) — a SEPARATE private git repo, so
# this codebase can be open-sourced without publishing third-party diffs or raw
# agent transcripts. AUDIT_DIR is its local path (relative paths resolve against
# the code repo root; empty = "<code root>/audit-data"). Bootstrap with
# `uv run atlas-watcher audit-init`.
AUDIT_REPO=garland3/ATLAS-WATCHER-LOGS
AUDIT_DIR=../ATLAS-WATCHER-LOGS
BOT_NAME=AGENT-REVIEW-BOT-3

# Agent CLIs. Each must accept the prompt on stdin.
# dclaude is typically: claude --dangerously-skip-permissions --print
DCLAUDE_CMD=claude --dangerously-skip-permissions --print
CODEX_CMD=codex exec
# OpenCode. Model ids are provider/model; OpenRouter's Auto Router is
# "openrouter/openrouter/auto" (provider "openrouter", model "openrouter/auto").
# --standalone is required for OPENCODE_CONFIG_CONTENT to take effect.
OPENCODE_CMD=opencode run --standalone --model openrouter/openrouter/auto --auto
# Merged over your opencode config for every agent run. Denying the subagent
# ("task") tool stops reviewers spawning sub-agents that re-read the PR.
OPENCODE_CONFIG_CONTENT={"permission":{"task":"deny"}}

# Extra agent commands. A value is either a command string or an object with
# "command" and an optional "vendor" (whose account the command drives — used
# for per-vendor cooldowns and MIN_SWARM_VENDORS counting).
# grok is xAI's own Grok CLI on its own xAI login (a vendor separate from
# OpenRouter's billing). It reads the prompt from stdin via
# --prompt-file /dev/stdin and writes files itself in headless mode.
# deepseek and glm are cheap flash models pinned through opencode on
# OpenRouter (same --standalone/override rules as OPENCODE_CMD). They bill the
# same OpenRouter credit as opencode, so they share its "openrouter" vendor:
# one credit/rate-limit cooldown pauses all three together. Swap the model id
# here to change models; no code change needed.
AGENT_COMMANDS={"grok": {"command": "grok --always-approve --permission-mode bypassPermissions --prompt-file /dev/stdin", "vendor": "xai"}, "deepseek": {"command": "opencode run --standalone --model openrouter/deepseek/deepseek-v4.1-flash --auto", "vendor": "openrouter"}, "glm": {"command": "opencode run --standalone --model openrouter/z-ai/glm-5.3-flash --auto", "vendor": "openrouter"}}

# Ordered fallback list per role. The first candidate whose binary exists and
# whose vendor is not cooling down runs the role; an infrastructure failure
# (rate limit, auth error, missing binary) fails over to the next candidate.
# Ordinary failures do NOT fail over. Entries are built-ins (dclaude, codex,
# cline, opencode) or names registered in AGENT_COMMANDS.
#   PERSPECTIVE_AGENTS — the 7 specialist reviewers
#   GENERIC_A_AGENTS / GENERIC_B_AGENTS — the two generic reviewers
#   MANAGER_AGENTS — supersedes MANAGER_AGENT (still honored if this is unset)
#   SECURITY_TRIAGE_AGENTS / ISSUE_TRIAGE_AGENTS — the triage agents
# The 8 bulk reviewers run on the cheap flash models; the manager (one call
# that writes the posted comment) and the triage agents keep the Auto Router.
# dclaude is the third candidate in every role.
PERSPECTIVE_AGENTS=deepseek,grok,dclaude
GENERIC_A_AGENTS=grok,codex,dclaude
GENERIC_B_AGENTS=glm,grok,dclaude
MANAGER_AGENTS=opencode,grok,dclaude,codex
SECURITY_TRIAGE_AGENTS=opencode,grok,dclaude,codex
ISSUE_TRIAGE_AGENTS=opencode,grok,dclaude,codex

# A review must draw on findings from at least this many distinct vendors
# before the manager runs. A swarm that cannot reach the minimum (every
# non-primary candidate capped/absent) is deferred — never posted as a
# single-vendor review. The manager itself never counts.
MIN_SWARM_VENDORS=2

# Which CLI runs the manager — the orchestrator that synthesizes the nine
# perspective reports into the final review. Any built-in above
# (dclaude/codex/cline/opencode) or a name registered in AGENT_COMMANDS:
#   AGENT_COMMANDS={"mycli": "my-agent --yes"}
# Changing this line is all that is needed to switch the orchestrator.
# Superseded by MANAGER_AGENTS above; kept as the fallback when that is unset.
MANAGER_AGENT=dclaude

# Agents use their own CLI login. A stale ANTHROPIC_API_KEY in the environment
# (notably one baked into a long-lived tmux server) shadows that login and 401s
# every agent, so each runner unsets it. Flip to true only if you deliberately
# drive the agents by API key.
AGENT_INHERIT_API_KEY=false

AGENT_TIMEOUT_SECS=5000
POLL_INTERVAL_SECS=5000
DIFF_CONTEXT_MAX_BYTES=200000

# Give up on a PR/issue after this many failed attempts at the same key.
# Failures are appended to the ledger as "failed" rows; a new PR commit or
# issue comment changes the key and resets the counter. To retry an exhausted
# item at the same key, remove its "failed" rows from ledger/ledger.jsonl.
MAX_RETRIES=3

# Security triage. Block-above and warn-above are risk thresholds:
# low < medium < high < critical. Set both to "critical" to disable.
SECURITY_BLOCK_ABOVE=high
SECURITY_WARN_ABOVE=medium
SECURITY_TIMEOUT_SECS=600

# Require corroboration before blocking. A lone ambiguous heuristic (one quoted
# jailbreak phrase, a stray zero-width char) is capped at "warn" — the review
# still runs, with the banner — unless the heuristic is decisive (bidi
# overrides, repeated prose directives), a second heuristic family agrees, or
# the model independently reaches the warn tier. Set false for the old
# "any single signal blocks" behavior.
SECURITY_REQUIRE_CORROBORATION=true
SECURITY_TEXT_MAX_BYTES=100000

# Repos that skip security triage entirely (comma-separated globs over
# owner/name, e.g. myorg/*). Empty = triage runs on every repo. Exempt only
# repos whose authors you trust, and list them in config.local.env — never
# here, this file is public.
SECURITY_EXEMPT_REPOS=

# Agent rate/session limits are account-wide (per vendor). On a detected
# limit the watcher cools down only that vendor; a role pauses only when
# every candidate for it is cooling, and a scan pass stops only when no role
# can run. The agent's stated reset time is honored when parseable, else the
# pause backs off exponentially, capped at the max.
AGENT_LIMIT_BACKOFF_SECS=3600
AGENT_LIMIT_BACKOFF_MAX_SECS=21600
# Ceiling on an agent-stated reset time (8 days — covers a weekly limit).
AGENT_LIMIT_RESET_MAX_SECS=691200

# Per-item retry backoff: an item that failed waits base * 2^(failures-1)
# seconds (capped) before the next attempt. Rate-limit failures are recorded
# as "deferred" and do not consume the retry budget at all.
RETRY_BACKOFF_BASE_SECS=900
RETRY_BACKOFF_MAX_SECS=86400
